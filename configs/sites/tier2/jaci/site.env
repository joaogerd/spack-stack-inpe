# =============================================================================
# JACI site runtime configuration for spack-stack-inpe
# =============================================================================
# This file contains machine-specific defaults used by the operational scripts.
# Users may override any variable from the shell before running the scripts.
# =============================================================================

export DEFAULT_PROJECT_ROOT="/p/projetos/monan_das/${USER}"
export DEFAULT_TEST_ID="spack-stack-inpe-test-release-2.1-gcc12"
export DEFAULT_ENV_NAME="jaci-mpas-jedi-gcc12-craympich"

export DEFAULT_SPACK_STACK_REPO="https://github.com/JCSDA/spack-stack.git"
export DEFAULT_SPACK_STACK_REF="release/2.1"
export DEFAULT_SPACK_STACK_INPE_REPO="https://github.com/joaogerd/spack-stack-inpe.git"
export DEFAULT_SPACK_STACK_INPE_REF="main"

export DEFAULT_SITE_STACK_PATH="configs/sites/tier2/jaci"
export DEFAULT_SOURCE_ENV_PATH="envs/jaci/mpas-jedi-gcc12-craympich"

export SITE_BASE_ENV_SCRIPT="scripts/sites/jaci/load_base_environment.sh"
export SITE_USES_CRAY_MPICH_OVERLAY="1"

export JACI_PRGENV_MODULE="PrgEnv-gnu/8.6.0"
export JACI_GCC_MODULE="gcc-native/12.3"
export JACI_GCC_MODULE_TO_UNLOAD="gcc-native/13.2"
export JACI_CRAYPE_TARGET_MODULE="craype-x86-turin"
export JACI_CRAY_MPICH_MODULE="cray-mpich/8.1.31"
export JACI_LIBFABRIC_MODULE="libfabric/1.22.0"
export JACI_CRAY_PALS_MODULE="cray-pals/1.6.1"

export CRAYPE_CC="${CRAYPE_CC:-/opt/cray/pe/craype/2.7.33/bin/cc}"
export CRAYPE_CXX="${CRAYPE_CXX:-/opt/cray/pe/craype/2.7.33/bin/CC}"
export CRAYPE_FC="${CRAYPE_FC:-/opt/cray/pe/craype/2.7.33/bin/ftn}"

export JACI_REAL_CRAY_MPICH_PREFIX="/opt/cray/pe/mpich/8.1.31/ofi/gnu/12.3"
export CRAY_MPICH_OVERLAY_PREFIX="${CRAY_MPICH_OVERLAY_PREFIX:-${WORK_ROOT:-${DEFAULT_PROJECT_ROOT}/work/${DEFAULT_TEST_ID}}/wrappers/cray-mpich-overlay}"

export JACI_ENV_MODULE="cray-mpich/8.1.31/none/none/jedi-mpas-env/1.0.0"

export JACI_MODULEPATH_ENTRIES="/opt/cray/pe/modulefiles:/opt/cray/modulefiles:/opt/cray/pe/craype-targets/default/modulefiles:/p/app/modulefiles:/opt/cray/pals/modulefiles"
